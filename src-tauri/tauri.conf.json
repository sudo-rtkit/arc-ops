{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ARC Raiders Companion",
  "version": "0.5.0",
  "identifier": "cz.arcops.companion",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "ARC Raiders Companion",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#101419"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "ARC Raiders Companion (neoficiální)",
    "shortDescription": "Osobní operační centrum hráče ARC Raiders",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "Czech",
          "English"
        ],
        "displayLanguageSelector": true,
        "customLanguageFiles": {
          "Czech": "nsis/Czech.nsh"
        }
      }
    }
  }
}
