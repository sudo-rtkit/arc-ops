{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Hlavní okno (plný i kompaktní režim, 0.16.1): jen poslech událostí a vlastní příkazy, které hlavní okno volá. Úložiště, dialogy, odkazy, buddy, snímek a ovládání okna jdou přes příkazy v Rustu; žádná oprávnění Tauri navíc (tray, menu, obrázky, cesty, emit z JS).",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-storage-load",
    "allow-storage-save",
    "allow-snapshot-create",
    "allow-snapshot-list",
    "allow-snapshot-read",
    "allow-snapshot-delete",
    "allow-import-save-raw",
    "allow-export-backup",
    "allow-import-backup",
    "allow-data-dir",
    "allow-open-data-dir",
    "allow-open-external",
    "allow-launch-info",
    "allow-bus-send",
    "allow-ops-enable",
    "allow-ops-hotkey",
    "allow-ops-watch",
    "allow-buddy-open",
    "allow-buddy-close",
    "allow-overlay-open",
    "allow-main-focus",
    "allow-capture-now",
    "allow-capture-take",
    "allow-ops-autocapture",
    "allow-ops-autostats",
    "allow-ops-passthrough",
    "allow-main-mode",
    "allow-main-pin",
    "allow-main-geometry",
    "allow-main-drag",
    "allow-main-minimize",
    "allow-main-hide",
    "allow-main-show",
    "allow-main-ready",
    "allow-app-quit",
    "allow-tray-sync",
    "allow-widgets-open",
    "allow-widgets-close",
    "allow-widgets-edit"
  ]
}
